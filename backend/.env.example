# ───────── Backend sozlamalari (nusxa: cp .env.example .env) ─────────
# Haqiqiy qiymatlar FAQAT .env da yoki hosting (Render) panelida turadi; bu fayl gitga kiradi, shuning uchun unda sirlar yo'q.

NODE_ENV=development
PORT=4000

# Ish vaqtidagi baza ulanishi.
#   Lokal (docker compose):  postgresql://altin:<POSTGRES_PASSWORD>@localhost:5434/altin_orda?schema=public
#   Neon (pooled, "-pooler" bor): postgresql://<user>:<parol>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL=

# Migratsiyalar uchun TO'G'RIDAN-TO'G'RI ulanish (Neon: pooler'siz host). Lokal: DATABASE_URL bilan bir xil.
DIRECT_URL=

# Kamida 32 belgi, tasodifiy. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Ruxsat etilgan frontend manzillari (vergul bilan). Ishlab chiqarishda faqat https://... (masalan, https://altin-orda.onrender.com)
CORS_ORIGIN=http://localhost:5173

MAX_UPLOAD_MB=5


# Admin / oqituvchi: server ishga tushganda hisob va parol yangilanadi.
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=
TEACHER_NAME=Ustoz

# Masofaviy seed kontentni qayta yozadi. Faqat kerak bolganda:
#SEED_CONFIRM=yes
